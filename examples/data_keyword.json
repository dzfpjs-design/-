{
  "kind": "tool",
  "namespace": "generic_data",
  "name": "data_keyword",
  "version": "1.0.0",
  "owner": "通用数据工具维护者",
  "description": "登记字段关键词过滤",
  "allowed_agent_roles": [
    "data"
  ],
  "execution": {
    "adapter": "builtin",
    "handler": "data_keyword_filter",
    "query_tool": true,
    "side_effect": false,
    "input_bindings": {
      "records": "data_records"
    }
  },
  "input_schema": {
    "type": "object",
    "required": [
      "records",
      "field",
      "text"
    ],
    "additionalProperties": false,
    "properties": {
      "records": {
        "type": "array",
        "minItems": 1,
        "maxItems": 200,
        "items": {
          "type": "object",
          "required": [
            "values",
            "entity_ids",
            "evidence_refs"
          ],
          "additionalProperties": false,
          "properties": {
            "values": {
              "type": "object"
            },
            "entity_ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 30,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "evidence_refs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 200,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "field": {
        "type": "string",
        "title": "登记字段",
        "minLength": 1,
        "maxLength": 100
      },
      "text": {
        "type": "string",
        "title": "要匹配的文字",
        "minLength": 1,
        "maxLength": 200
      }
    }
  },
  "output_schema": {
    "type": "object",
    "required": [
      "records",
      "summary"
    ],
    "additionalProperties": false,
    "properties": {
      "records": {
        "type": "array",
        "maxItems": 200,
        "items": {
          "type": "object",
          "required": [
            "values",
            "entity_ids",
            "evidence_refs"
          ],
          "additionalProperties": false,
          "properties": {
            "values": {
              "type": "object"
            },
            "entity_ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 30,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "evidence_refs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 200,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "summary": {
        "type": "object"
      }
    }
  },
  "budget": {
    "max_attempts": 2,
    "max_concurrency": 1
  },
  "data_policy": {
    "external_allowed": false
  },
  "specification": {
    "sample_unit": "evidence_records"
  }
}
