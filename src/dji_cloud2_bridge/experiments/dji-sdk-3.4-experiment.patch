+// One process owns one main SDK session. Snapshot contains no server text or
+// credentials. Low bits: pending=0, open=1, disconnected=4; upper bits: last
+// authentication rejection none=0, 401=2, 403=3. Only OnOpen clears history.
+namespace {
+std::atomic<int> bridge_ws_snapshot{0};
+void bridge_failed(int auth) {
+    int previous = bridge_ws_snapshot.load();
+    int next;
+    do {
+        const int last_auth = auth ? auth : (previous >> 3);
+        next = 4 | (last_auth << 3);
+    } while (!bridge_ws_snapshot.compare_exchange_weak(previous, next));
+}
+}
+extern "C" __attribute__((visibility("default"))) int
+Java_DjiCloud2Bridge_nativeWebSocketSnapshotV2(void*, void*) {
+    return bridge_ws_snapshot.load();
+}
